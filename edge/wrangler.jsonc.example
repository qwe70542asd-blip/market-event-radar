{
  "name": "market-event-radar-live",
  "main": "market-live-worker.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1144701",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
